{
  "compilerOptions": {
    
    
    "rootDir": "./src",
    "outDir": "./dist",

    
    "target": "ES2020",
    "module": "CommonJS",

    
    "esModuleInterop": true,
    "resolveJsonModule": true,

    
    "sourceMap": true,
    "declaration": true,

    
    "strict": true,

    
    "skipLibCheck": true
  },

  
  "include": ["src/**/*"],

  
  "exclude": ["node_modules", "dist"]
}